# Set these in the server process environment; this file is documentation, not auto-loaded.
PAYMENT_MODE=demo
# To enable PayPal test checkout, set PAYMENT_MODE=sandbox and supply sandbox credentials.
# Both credentials must belong to the ONE sandbox treasurer configured for this development build.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must match the group receiving account and belong to the sandbox app above.
# The treasurer's SaveKin login email can be different after declaring the group receiving account.
PAYPAL_TREASURER_EMAIL=
# Required to verify real sandbox webhook deliveries (not simulator mock notifications).
PAYPAL_WEBHOOK_ID=
# Optional savings-record explainer; no calls are made without configuration and in-app consent.
OPENAI_API_KEY=
OPENAI_MODEL=

# Sandbox estimator only: US Checkout example; actual fees can differ.
PAYPAL_FEE_BPS=349
PAYPAL_FEE_FIXED_CENTS=49

# AI_PROVIDER selects one provider; no automatic fallback.
AI_PROVIDER=openai
# For Elastic Cloud managed models, choose AI_PROVIDER=elastic.
ELASTIC_KIBANA_URL=
ELASTIC_API_KEY=
ELASTIC_AGENT_ID=savekin-helper

# Transactional email. This file is not auto-loaded; set these in your launcher terminal.
# ssl (port 465) or starttls (usually port 587); plaintext SMTP is not supported.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Optional local development delivery instead of SMTP: SAVEKIN_MAIL_MODE=local
# Saves .eml previews beside the SQLite database under mail-preview/, never in a public route.
SAVEKIN_MAIL_MODE=
